# Ambiente
NODE_ENV=development
PORT=3333

# Banco — use bancos distintos para desenvolvimento e produção.
# Estas URLs correspondem ao docker-compose.yml deste repositório (porta 5434).
# Menor privilégio (ver scripts/papeis-do-banco.sql):
#   DATABASE_URL  papel do servidor: só lê e escreve dados
#   DIRECT_URL    papel dono do schema: usado só pelas migrações (prisma migrate)
DATABASE_URL="postgresql://taskon_app:taskon_app@localhost:5434/taskon_dev?schema=public"
DIRECT_URL="postgresql://taskon:taskon@localhost:5434/taskon_dev?schema=public"

# Banco de testes. Separado porque a bateria apaga todas as tabelas.
TEST_DATABASE_URL="postgresql://taskon_app:taskon_app@localhost:5434/taskon_test?schema=public"

# Quantos proxies confiáveis ficam na frente do backend (0 em desenvolvimento;
# 1 atrás de um Caddy/Nginx). Define de onde vem o IP usado no rate limit.
TRUST_PROXY_HOPS=0

# Segredo de sessão (mínimo 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="troque-este-valor-por-um-segredo-de-32-caracteres-ou-mais"
BETTER_AUTH_URL="http://localhost:3333"
FRONTEND_URL="http://localhost:3000"

# Login social (opcional: sem as chaves, o provedor fica desligado)
# Callback: http://localhost:3333/api/auth/callback/google
# As mesmas chaves servem à integração com o Google Agenda, que tem outro
# callback: http://localhost:3333/api/integracoes/google/callback (ver README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: http://localhost:3333/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# E-mail. Sem a chave, as mensagens são impressas no console do backend, com o
# link utilizável — o suficiente para desenvolver sem depender de serviço externo.
RESEND_API_KEY=
# O Resend recusa remetente de domínio não verificado (403). "onboarding@resend.dev"
# funciona sem verificação, mas só entrega para o e-mail dono da conta Resend.
# Em produção, use um endereço de domínio próprio já verificado no Resend.
MAIL_FROM="Taskon <onboarding@resend.dev>"

# Protege a rota das rotinas agendadas. Sem este valor, a rota nao e registrada:
# deixa-la aberta permitiria que qualquer um disparasse a purga da lixeira.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Conta de desenvolvimento criada por "npm run db:seed".
# Existe para destravar o acesso local: sem um domínio verificado no Resend, o
# e-mail de confirmação não chega a qualquer endereço, e o login por senha é
# recusado enquanto o e-mail não for confirmado. A semente grava o endereço
# como já verificado e recusa rodar com NODE_ENV=production.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
